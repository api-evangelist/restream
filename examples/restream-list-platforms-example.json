{
  "operationId": "listPlatforms",
  "summary": "List All Platforms",
  "request": {
    "method": "GET",
    "url": "https://api.restream.io/v2/platform/all",
    "headers": {}
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": [
      {
        "id": 1,
        "name": "Twitch",
        "url": "https://twitch.tv",
        "image": {
          "png": "https://restream.io/assets/platforms/twitch.png",
