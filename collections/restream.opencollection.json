              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve all channels associated with the authenticated user's account."
        },
        {
          "info": {
            "name": "Get Channel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.restream.io/v2/user/channel/:id",
            "params": [
              {
                "name": "id",
                "value": "",
